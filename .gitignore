# ============================================================
# WebNovel Trends .gitignore
# ============================================================

# ----------------------------------------------------------
# Python
# ----------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# ----------------------------------------------------------
# Virtual environments
# ----------------------------------------------------------
.env
.envrc
.venv
venv/
env/
ENV/
env.bak/
venv.bak/

# ----------------------------------------------------------
# IDE / Editor
# ----------------------------------------------------------
.idea/
.vscode/
.cursorignore
.cursorindexingignore
.spyderproject
.spyproject
.ropeproject

# ----------------------------------------------------------
# OS junk
# ----------------------------------------------------------
.DS_Store
Thumbs.db

# ----------------------------------------------------------
# Node (frontend)
# ----------------------------------------------------------
node_modules/
package-lock.json
ui/frontend/node_modules/
ui/frontend/package-lock.json
ui/backend/node_modules/
ui/backend/package-lock.json

# ----------------------------------------------------------
# Project outputs (runtime-generated, not source)
# ----------------------------------------------------------
outputs/
tests/test_output/
data/
# Model weights (keep models/*.py for LLM provider code)
models/*/
!models/__init__.py
!models/*.py

# ----------------------------------------------------------
# Logs
# ----------------------------------------------------------
*.log

# ----------------------------------------------------------
# PyInstaller
# ----------------------------------------------------------
*.exe
*.manifest
build/
dist/
build_temp/

# ----------------------------------------------------------
# Distribution / packaging
# ----------------------------------------------------------
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# ----------------------------------------------------------
# Testing / coverage
# ----------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# ----------------------------------------------------------
# Type checkers / linters
# ----------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# ----------------------------------------------------------
# Misc tooling
# ----------------------------------------------------------
.pypirc
.pdm-python
.pdm-build/
.pixi
__pypackages__/
celerybeat-schedule
celerybeat.pid
*.sage.py
.ipynb_checkpoints
profile_default/
ipython_config.py
pip-log.txt
pip-delete-this-directory.txt
*.mo
*.pot
/site
.scrapy
docs/_build/
.pybuilder/
target/
.abstra/
.webassets-cache

# ----------------------------------------------------------
# SQLite (project DB is in outputs/ which is already ignored;
#         this catches stray DB files at repo root)
# ----------------------------------------------------------
db.sqlite3
db.sqlite3-journal

# Database（持久化数据，不上传）
data/*.db
data/*.db-journal
data/*.db-wal